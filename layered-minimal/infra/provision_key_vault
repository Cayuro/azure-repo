#!/bin/bash
set -e

RESOURCE_GROUP="rg-centinela-prod"
LOCATION="chilecentral"
KEYVAULT_NAME="kv-centinela-prod"
APP_SERVICE_NAME="appcentinelaprodgrupo3"
SCORING_THRESHOLD="60"

echo "=============================================================================="
echo "INICIANDO CONFIGURACIÓN EN AZURE (Chile Central) - FASE INGESTA"
echo "=============================================================================="

# 1. CREAR EL KEY VAULT
echo "--> 1. Creando Azure Key Vault '$KEYVAULT_NAME' en $LOCATION..."
az keyvault create \
  --name "$KEYVAULT_NAME" \
  --resource-group "$RESOURCE_GROUP" \
  --location "$LOCATION" \
  --enable-rbac-authorization true \
  --output none

KEYVAULT_ID=$(az keyvault show --name "$KEYVAULT_NAME" --resource-group "$RESOURCE_GROUP" --query "id" --output tsv)

# 1.5 DAREMOS PERMISOS AL USUARIO ACTUAL QUE EJECUTA EL SCRIPT (Juan)
echo "--> 1.5 Asignando rol 'Key Vault Secrets Officer' a tu usuario para poder guardar secretos..."
MY_USER_ID=$(az ad signed-in-user show --query id --output tsv)

az role assignment create \
  --assignee "$MY_USER_ID" \
  --role "Key Vault Secrets Officer" \
  --scope "$KEYVAULT_ID" \
  --output none

echo "    ⏳ Esperando 45 segundos para propagación del rol en Azure..."
sleep 45

# 2. GUARDAR EL UMBRAL DE SCORING EN KEY VAULT
echo "--> 2. Guardando 'ingesta-scoring-threshold' en Key Vault..."

az keyvault secret set \
  --vault-name "$KEYVAULT_NAME" \
  --name "ingesta-scoring-threshold" \
  --value "$SCORING_THRESHOLD" \
  --output none

echo "    ✔ Secreto del umbral creado con éxito ($SCORING_THRESHOLD)."

# 3. ACTIVAR MANAGED IDENTITY EN EL APP SERVICE
echo "--> 3. Activando Managed Identity (System-Assigned) en '$APP_SERVICE_NAME'..."

PRINCIPAL_ID=$(az webapp identity assign \
  --name "$APP_SERVICE_NAME" \
  --resource-group "$RESOURCE_GROUP" \
  --query "principalId" \
  --output tsv)

echo "    ✔ Managed Identity creada con Principal ID: $PRINCIPAL_ID"

# 4. ASIGNAR ROL RBAC A LA APP
echo "--> 4. Asignando rol 'Key Vault Secrets User' a la Managed Identity del App Service..."

az role assignment create \
  --assignee "$PRINCIPAL_ID" \
  --role "Key Vault Secrets User" \
  --scope "$KEYVAULT_ID" \
  --output none

echo "=============================================================================="
echo " ¡CONFIGURACIÓN COMPLETADA CON ÉXITO!"
echo "=============================================================================="
