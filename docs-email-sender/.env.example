# =============================================================
# Variables para los scripts de docs/scripts/
#
# Uso:
#   cp docs/.env.example docs/.env
#   # editar docs/.env con tus valores
#   bash docs/scripts/01-storage-queue.sh
#
# Los scripts cargan docs/.env automaticamente si existe. .env esta en
# .gitignore; .env.example (este archivo) si se versiona.
#
# Aqui NO van secretos: los scripts de aprovisionamiento solo necesitan
# nombres y regiones. El connection string de Azure Communication Services
# se lee de local.settings.json (que tampoco se versiona) o directamente de
# Azure con `az communication list-key`.
# =============================================================

# ---------- Comunes ----------
# Resource group donde vive todo. Debe existir previamente.
RG=rg-centinela-prod

# Region de computo y datos. Ojo: no todas las regiones soportan todos los
# planes de Azure Functions (ver 01-servicios-y-arquitectura.md).
LOCATION=chilecentral

# ---------- 01 - Storage Queue ----------
# 3-24 caracteres, solo minusculas y numeros, unico a nivel global en Azure.
STORAGE_ACCOUNT=stcolafraudecentinela
QUEUE_NAME=cola-casos-fraude
# Si se omite, se deriva como "${QUEUE_NAME}-poison".
QUEUE_POISON_NAME=cola-casos-fraude-poison
STORAGE_SKU=Standard_LRS

# Managed Identity (principalId) del App Service que publica los eventos de
# fraude. Se usa para darle permiso de escritura sobre la cola sin claves.
# Obtenerlo con:
#   az webapp identity show --name <app-service> -g $RG --query principalId -o tsv
PRODUCER_PRINCIPAL_ID=6badd152-aa42-4ffd-a996-b7b766d700b1

# ---------- 02 - Azure Communication Services (Email) ----------
ACS_NAME=acs-centinela-prod
EMAIL_SERVICE_NAME=acs-email-centinela-prod
# Residencia de datos de ACS. Valores validos (fijos, no son regiones de Azure):
# United States | Europe | UK | Brazil | Asia Pacific | Australia | Canada | ...
# Chile no es una opcion; Brazil es la mas cercana.
DATA_LOCATION=Brazil

# ---------- 03 - App Service Plan ----------
# Plan DEDICADO para la Function. No reutilizar el plan del App Service de
# scoring (ver 01-servicios-y-arquitectura.md, decision 4).
PLAN_NAME=asp-func-email-sender
PLAN_SKU=B1

# ---------- 04 - Function App ----------
# Unico a nivel global (forma parte de la URL *.azurewebsites.net).
FUNCTION_APP_NAME=func-email-sender-centinela
